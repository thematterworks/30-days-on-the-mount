# Supabase (PostgreSQL) — server-only, never exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
# Custom secret string you choose and enter in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# AI Engine (Anthropic)
AI_API_KEY=your-anthropic-api-key

# Vercel Cron
# Also set this exact value as the Authorization: Bearer header Vercel Cron sends.
CRON_SECRET=choose-a-long-random-string

# Admin dashboard auth (single admin credential)
ADMIN_EMAIL=admin@30daysonthemount.com
# bcrypt hash of the admin password — generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH=$2a$10$replace-with-a-real-bcrypt-hash
# Random secret used to HMAC-sign the admin session cookie.
ADMIN_SESSION_SECRET=choose-a-long-random-string
