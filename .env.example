# Supabase (PostgreSQL) — server-only, never exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
# Custom secret string you choose and enter in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# Twilio Programmable Messaging (SMS/MMS channel)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# E.164 format, e.g. +13237477471. Also used to validate the
# X-Twilio-Signature header on inbound webhook requests.
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Optional. Only needed if X-Twilio-Signature validation fails in production.
# Twilio signs the exact URL configured in the console; the webhook normally
# reconstructs that from Vercel's x-forwarded-proto/x-forwarded-host headers.
# Set this to the literal console value (note apex vs. www — they sign
# differently) if a redirect or CDN in front of the app breaks that.
# TWILIO_WEBHOOK_URL=https://www.30daysonthemount.com/api/webhook/sms

# AI Engine (Anthropic). ANTHROPIC_API_KEY also works as an alias if that's
# what you've already set — the app checks AI_API_KEY first, then falls
# back to ANTHROPIC_API_KEY. Set exactly one; don't leave trailing whitespace
# or a newline when pasting into Vercel, it will cause auth failures.
AI_API_KEY=your-anthropic-api-key

# Vercel Cron
# Also set this exact value as the Authorization: Bearer header Vercel Cron sends.
CRON_SECRET=choose-a-long-random-string

# Admin dashboard auth (single admin credential)
ADMIN_EMAIL=admin@30daysonthemount.com
# bcrypt hash of the admin password — generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" 'your-password'
ADMIN_PASSWORD_HASH=$2a$10$replace-with-a-real-bcrypt-hash
# Random secret used to HMAC-sign the admin session cookie.
ADMIN_SESSION_SECRET=choose-a-long-random-string
# Separate random secret used to HMAC-sign participant (/journey PWA) session
# cookies. MUST differ from ADMIN_SESSION_SECRET so a leak of one can never
# forge the other.
PARTICIPANT_SESSION_SECRET=choose-a-different-long-random-string

# Email delivery (Resend) — optional. If unset, the daily-push cron simply
# skips the email side-channel for participants who opted into it; WhatsApp
# delivery is unaffected either way.
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=30 Days on the Mount <onboarding@30daysonthemount.com>
